{
  "name": "revenue-os",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "engines": {
    "bun": "1.3.11"
  },
  "scripts": {
    "local": "bun scripts/local-env.ts",
    "cycle": "bun scripts/cycle.ts",
    "proof": "bun scripts/proof/cli.ts",
    "dev": "bun --watch services/worker/src/index.ts & bun run --filter console dev",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit -p tsconfig.base.json && tsc --noEmit -p apps/console && tsc --noEmit -p apps/www",
    "db:reset": "bun scripts/db-reset.ts",
    "db:seed": "bun scripts/local-env.ts bun scripts/seed.ts",
    "demo": "bun scripts/demo.ts",
    "rls:check": "psql \"${LOCAL_DB_URL:-postgresql://postgres:postgres@127.0.0.1:54322/postgres}\" -v ON_ERROR_STOP=1 -f tests/rls_coverage.sql",
    "gate": "bun scripts/done-gate.ts",
    "gates": "bun run gate",
    "see": "bun scripts/done-gate.ts see",
    "evals": "bun scripts/evals.ts",
    "guards": "bash scripts/guards.sh",
    "dev:console": "bun run --filter console dev",
    "e2e": "playwright test -c apps/console/playwright.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@playwright/test": "1.61.1",
    "@revenue-os/db": "workspace:*",
    "@revenue-os/harness": "workspace:*",
    "@revenue-os/shared": "workspace:*",
    "@types/pg": "8.20.0",
    "bun-types": "1.3.11",
    "pg": "8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typebox": "1.3.27",
    "typescript": "7.0.2"
  },
  "overrides": {
    "postcss": "8.5.23",
    "nanoid": "3.3.19",
    "source-map-js": "1.2.2"
  }
}
